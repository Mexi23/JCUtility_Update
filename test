			}
		}
	}

	@Override
	protected void onProgressUpdate(Integer... progress) {
		super.onProgressUpdate(progress);

		int current = progress[progress.length - 1];
		int percent = 0;

		if (totalFiles > 0) {
			percent = (int)((current * 100) / totalFiles);
		}

		progressbar2.setProgress(percent);
		process_files.setText(current + " / " + totalFiles + " files processed");
		process_percent.setText(percent + "%");

		long elapsed = (System.currentTimeMillis() - extractStartTime) / 1000;
		process_seconds.setText(elapsed + " seconds");
	}

	@Override
	protected void onPostExecute(Integer result) {
		super.onPostExecute(result);

		progressbar2.setProgress(100);
		process_percent.setText("100%");

		if (ODialog != null) {
			ODialog.dismiss();
		}

		try {

			DocumentsContract.deleteDocument(
				getApplicationContext().getContentResolver(),
				srcZipFile.getUri()
			);

			TastyToast.makeText(
				MainActivity.this,
				"Download Completed!",
				TastyToast.LENGTH_LONG,
				TastyToast.SUCCESS
			);

		} catch (FileNotFoundException e) {

			TastyToast.makeText(
				MainActivity.this,
				"Error",
				TastyToast.LENGTH_LONG,
				TastyToast.ERROR
			);
		}
	}




